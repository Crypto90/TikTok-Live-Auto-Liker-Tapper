# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller Build Artifacts
build/
dist/
*.spec

# Runtime & User Data
userdata/
avatars/
favorites.json
settings.json

# Logs & Debugging
*.log

# Operating System Files
.DS_Store
Thumbs.db

# Executables
*.exe

# Secrets & runtime state written next to the app when run from source
cookies.json
dashboard_token.txt
sync_state.json
stats.json

# Test & lint caches
.pytest_cache/
.ruff_cache/
